# Copy to .env and edit. Every setting is optional.

# Use your own Postgres instead of the built-in SQLite database.
# Tables are created automatically. Hosted Postgres usually needs ?sslmode=require at the end.
#   DATABASE_URL=postgres://user:password@db.example.com:5432/recall?sslmode=require
DATABASE_URL=

# Port on the host
RECALL_PORT=3000


# Your timezone, so "today" (daily new-card limits, streaks) matches your day
TZ=Europe/London

# The address people use to reach Recall. Passkeys and sign-in providers need it to be exact.
PUBLIC_URL=https://recall.example.com

# Optional: one OpenID Connect provider from the environment (you can also add providers in Instance admin > Sign in)
# AUTH_OAUTH_NAME=Company SSO
# AUTH_OAUTH_ISSUER=https://auth.example.com/application/o/recall
# AUTH_OAUTH_CLIENT_ID=
# AUTH_OAUTH_CLIENT_SECRET=
# AUTH_OAUTH_ALLOW_SIGNUP=false

# Set to 1 when running behind a single reverse proxy (Caddy, nginx, Traefik) so client IPs are read correctly
TRUST_PROXY=

# FSRS target recall probability (0.7 - 0.97). Higher = more reviews, better recall.
DESIRED_RETENTION=0.9

# Study reminders as a Slack DM (optional). Create a Slack app with the bot scopes chat:write and
# users:read.email, install it to your workspace, and paste its Bot User OAuth Token (xoxb-...).
# Set PUBLIC_URL too, so the reminder links to your Recall.
SLACK_BOT_TOKEN=
